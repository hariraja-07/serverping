# Copy to `.env` and edit. `.env` is gitignored — this file is what gets committed, so keep
# only placeholders here.
#
#   cp .env.example .env
#
# docker compose reads .env automatically from the project directory.

POSTGRES_USER=serverping
POSTGRES_PASSWORD=serverping
POSTGRES_DB=serverping

# Host port the API is published on. Change if 8080 is taken.
SERVER_PORT=8080

# Host port Postgres is published on, bound to 127.0.0.1 so ./mvnw spring-boot:run can
# reach it while the LAN cannot. Must match spring.datasource.url on the host.
POSTGRES_PORT=5432
